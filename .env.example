POSTGRES_USER=tutor
POSTGRES_PASSWORD=change_me
POSTGRES_DB=tutor_rag
# Used by Python/Alembic on the host. Compose sets its own URL with hostname db.
DATABASE_URL=postgresql+asyncpg://tutor:change_me@localhost:5432/tutor_rag
APP_NAME=Tutor RAG
DEBUG=false

# Gemini API free tier: use a project without billing to avoid paid usage.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
EMBEDDING_TIMEOUT=30
GEMINI_API_KEY=

# Teaching materials: Gemini shares GEMINI_API_KEY with embeddings.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
LLM_TIMEOUT=180
# For Ollama: set LLM_PROVIDER=ollama and LLM_MODEL to your installed model.
# Inside Docker configure a reachable host address.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Integrations (single-tutor local deployment). Register this exact callback in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback
# Generate once with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Keep this stable: changing it makes stored OAuth tokens unreadable.
INTEGRATION_ENCRYPTION_KEY=
TELEGRAM_BOT_TOKEN=
PUBLIC_APP_URL=http://localhost:5173
WORKER_INTERVAL_SECONDS=30
